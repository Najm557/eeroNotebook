# ─── eeroNotebook deployment configuration ────────────────────────────────────
# Copy to .env beside this file and fill in. .env is gitignored — never commit it.
#
#   cp .env.example .env
#
# Generate each secret separately, e.g.:  openssl rand -hex 32
# ──────────────────────────────────────────────────────────────────────────────

# The Dev Server's address. Held here and nowhere else, so relocating the host
# is a single edit (Requirement 13.7). Becomes a DNS name once internal DNS is
# confirmed. Note the inference backend is NOT reached via this address — the
# gateway uses the runtime's host alias instead.
EERONOTEBOOK_HOST=10.17.8.52

# The name eeroNotebook is served under by mon-traefik, following the *.local
# convention the other stacks on this host already use. Defined once and used
# three ways: the proxy's router rules, the certificate's SANs, and the HTTPS
# origin the browser is told to call the API on. Change it here and re-run
# deploy/traefik/setup-ingress.sh.
#
# No DNS server serves these names yet, so clients need an /etc/hosts entry
# pointing this name and api.<name> at EERONOTEBOOK_HOST.
EERONOTEBOOK_DOMAIN=eeronotebook.local

# Encrypts stored provider credentials at rest. Required — the application will
# not start without it. Changing it later makes existing stored credentials
# unreadable.
OPEN_NOTEBOOK_ENCRYPTION_KEY=

# Database. Upstream ships root:root; both must be replaced. The database is
# never published to the host, but these are still real credentials.
SURREAL_USER=eeronotebook
SURREAL_PASSWORD=
SURREAL_NAMESPACE=eeronotebook
SURREAL_DATABASE=eeronotebook

# The credential the application presents to the Inference Gateway. Prevents the
# gateway acting as an open inference proxy for anything else on the shared
# monitoring network.
LITELLM_MASTER_KEY=

# Inference backend behind the gateway. The host alias resolves to the Dev
# Server's loopback interface, which is why the backend need not listen on any
# network address. Point this elsewhere to move inference — for example to a
# GPU-equipped Linux host, where the model server can itself be containerised.
INFERENCE_BACKEND_URL=http://host.docker.internal:11434

# Maximum tokens per embedding chunk. Pinned here rather than left to the
# application's 400-token default, because that default is only safe by
# coincidence: the application warns above 8192, four times the window
# nomic-embed-text actually accepts, so nothing in it would object to a value
# that silently truncates every embedding.
#
# The ceiling is 2048 — nomic-embed-text's input window (Requirement 1.4).
# 400 is what the deployed stack was measured producing (spec task 3.4: 57
# chunks over three Sources, largest 393 tokens), so pinning it changes no
# behaviour. Chunks are measured with tiktoken's o200k_base rather than the
# embedder's own WordPiece tokenizer, so this count is a proxy that tends to
# read low; the 5x headroom at 400 absorbs that error, a value set at 2048
# would not.
#
# tests/test_chunking.py enforces the ceiling against this file, so raising it
# past 2048 fails a test instead of degrading embeddings quietly. The
# application reads chunking constants at import, so restart eeronotebook-app
# after changing this — and re-embed existing Sources, since stored vectors
# keep whatever size they were built with.
OPEN_NOTEBOOK_CHUNK_SIZE=400

# Interim single shared password, replaced by per-user identity in spec task 5.
# Until then this is the only thing standing between the network and the
# notebooks.
OPEN_NOTEBOOK_PASSWORD=
# ─── Identity (spec task 5) ───────────────────────────────────────────────────
# GoTrue authenticates members and issues JWTs. It runs in this stack with its
# own Postgres, deliberately separate from legendary-hunts' lh-auth so that a
# compromise or migration there cannot reach eeroNotebook.

# GoTrue's Postgres. Never published to the host; still real credentials.
#
# Generate as hex, not base64: this password is interpolated into a postgres://
# connection URL in docker-compose.yml, and characters such as @ : / or ?
# would terminate the URL early and produce a confusing connection failure.
#
#   openssl rand -hex 24
AUTH_DB_USER=eeronotebook_auth
AUTH_DB_NAME=eeronotebook_auth
AUTH_DB_PASSWORD=

# Signs and verifies member access tokens. This is the root of trust for the
# whole identity system: anyone holding it can mint a token for any member, so
# it belongs nowhere but this file.
#
# Deliberately not shared with lh-auth's JWT secret — a shared signing key would
# make tokens from that stack valid here.
#
# Rotating it invalidates every issued token, signing every member out at once.
#
#   openssl rand -hex 32
GOTRUE_JWT_SECRET=
