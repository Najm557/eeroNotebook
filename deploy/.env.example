# ─── eeroNotebook deployment configuration ────────────────────────────────────
# Copy to .env beside this file and fill in. .env is gitignored — never commit it.
#
#   cp .env.example .env
#
# Generate each secret separately, e.g.:  openssl rand -hex 32
# ──────────────────────────────────────────────────────────────────────────────

# The Dev Server's address. Held here and nowhere else, so relocating the host
# is a single edit (Requirement 13.7). Becomes a DNS name once internal DNS is
# confirmed. Note the inference backend is NOT reached via this address — the
# gateway uses the runtime's host alias instead.
EERONOTEBOOK_HOST=10.17.8.52

# Encrypts stored provider credentials at rest. Required — the application will
# not start without it. Changing it later makes existing stored credentials
# unreadable.
OPEN_NOTEBOOK_ENCRYPTION_KEY=

# Database. Upstream ships root:root; both must be replaced. The database is
# never published to the host, but these are still real credentials.
SURREAL_USER=eeronotebook
SURREAL_PASSWORD=
SURREAL_NAMESPACE=eeronotebook
SURREAL_DATABASE=eeronotebook

# The credential the application presents to the Inference Gateway. Prevents the
# gateway acting as an open inference proxy for anything else on the shared
# monitoring network.
LITELLM_MASTER_KEY=

# Inference backend behind the gateway. The host alias resolves to the Dev
# Server's loopback interface, which is why the backend need not listen on any
# network address. Point this elsewhere to move inference — for example to a
# GPU-equipped Linux host, where the model server can itself be containerised.
INFERENCE_BACKEND_URL=http://host.docker.internal:11434

# Interim single shared password, replaced by per-user identity in spec task 5.
# Until then this is the only thing standing between the network and the
# notebooks.
OPEN_NOTEBOOK_PASSWORD=
